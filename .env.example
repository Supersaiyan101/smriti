# ==============================================================================
# Smriti (स्मृति) — Environment Configuration Template
# ==============================================================================

# Node Environment & Server Port
NODE_ENV=development
PORT=3001

# ------------------------------------------------------------------------------
# 1. Partner: MongoDB Atlas (Vector Search & Sanctuary Storage)
# Target Category: Best Use of MongoDB Atlas
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smriti?retryWrites=true&w=majority
# (If left empty, Smriti automatically runs in resilient local persistent storage)
# ------------------------------------------------------------------------------
MONGODB_URI=
MONGODB_DB_NAME=smriti

# ------------------------------------------------------------------------------
# 2. Partner: Google Gemma (Open-Weight Brain & Reflection Synthesis)
# Target Category: Best Use of Gemma
# Options:
#   - Local Ollama: http://localhost:11434 (model: gemma2:9b or gemma2:2b)
#   - OpenRouter / vLLM: https://openrouter.ai/api/v1 (model: google/gemma-2-9b-it)
# ------------------------------------------------------------------------------
GEMMA_API_BASE=http://localhost:11434
GEMMA_MODEL=gemma2:9b
EMBEDDING_MODEL=all-minilm

# ------------------------------------------------------------------------------
# 3. Partner: ElevenLabs (Spoken Voice Synthesis)
# Target Category: Best Use of ElevenLabs
# (If left empty, Smriti automatically uses native browser speech synthesis fallback)
# ------------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ------------------------------------------------------------------------------
# 4. Partner: Sentry (Agent Tracing & Observability)
# Target Category: Best Use of Sentry
# ------------------------------------------------------------------------------
SENTRY_DSN=

# ------------------------------------------------------------------------------
# 5. Partner: Render (AI Frontend & API Runtime)
# Target Category: Best Use of Render
# Configured via render.yaml
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 6. Partner: Mastra (Agent Workflow Orchestration)
# Target Category: Best Use of Mastra
# Orchestration pipeline located in server/mastra/agent.js
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 7. Partner: .tech Domain (Custom Domain)
# Target Category: Best Use of a .tech Domain
# e.g. https://smriti.tech
# ------------------------------------------------------------------------------
APP_DOMAIN=smriti.tech
