# Smriti (स्मृति) Server Configuration

# Server Port
PORT=3001

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smriti?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=smriti

# AI Brain (Google Gemma)
# When using Ollama locally: http://localhost:11434
# When using an OpenAI-compatible / OpenRouter API:
GEMMA_API_BASE=http://localhost:11434
GEMMA_MODEL=gemma2:9b

# Voice Synthesis (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Observability (Sentry)
SENTRY_DSN=
